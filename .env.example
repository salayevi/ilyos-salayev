# Copy to .env.local and fill in. Never put a real value in THIS file — it is
# the one env file the ecosystem expects to be committed, and `.gitignore` is a
# single edit away from stopping protecting it.

# Signing key for the admin session cookie. Must be at least 32 characters.
# Generate one with:  openssl rand -base64 32
SESSION_SECRET=

# Integration secrets entered from the owner dashboard are encrypted with a
# separate root key so rotating SESSION_SECRET does not make them unreadable.
# This is the only bootstrap secret that cannot safely live inside that same
# encrypted database. Generate independently: openssl rand -base64 32
APP_MASTER_KEY=

# Postgres. Locally this is your own instance; in production it is the Railway
# connection string, which must be set for the `production` target and not just
# for `preview` — the site renders without it, silently and completely empty.
DATABASE_URL=postgresql://user:password@localhost:5432/portfolio

# Remote database certificates are verified by default. Leave true in
# production. Set false only temporarily for a provider using a private CA.
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Seed credentials for the first admin row. Used by `npm run db:seed` only.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Canonical origin. Every sitemap entry, canonical tag, Open Graph URL and
# structured-data @id is built from this, and the session cookie's Secure flag
# is keyed off its scheme. Pointing it at localhost in production tells every
# crawler the site lives on your laptop.
NEXT_PUBLIC_SITE_URL=https://ilyos-salayev.site

# Optional. Read-only scope is enough — used to import repository metadata when
# adding a project from a GitHub URL in the panel.
GITHUB_TOKEN=

# Screenshot renderer. `{url}` is replaced with the percent-encoded target
# (`{url_raw}` with the plain one). Defaults to WordPress mShots, which needs
# no key. Any provider returning an image works, e.g.:
#   https://api.screenshotone.com/take?access_key=KEY&url={url}&viewport_width=1280
SCREENSHOT_API_URL=
